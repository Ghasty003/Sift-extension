{
  "manifest_version": 3,
  "name": "Sift",
  "version": "0.1.0",
  "description": "Save X posts to Sift",

  "permissions": [
    "storage"
  ],

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },

  "options_page": "options.html",

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["sift-button.css"]
    }
  ]
}